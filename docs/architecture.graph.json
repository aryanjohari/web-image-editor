{
  "version": 1,
  "title": "Background Studio",
  "summary": "Upload a hero, pick a look or mood, tune sliders, and export reusable preset JSON from one WebGL pass. Optional AI mood runs through a small Vercel API.",
  "notes": "C2-derived portfolio map. Collapses SPA internals (shells, SynthMaterial, preset lib) into spa + shader; keyword mood is inside the SPA. Preset JSON is built from Zustand (not pixels from the GPU)—the shader edge is the visitor happy path. Dashed edges are optional AI. Full C4: docs/c4/.",
  "c4": {
    "level": "containers",
    "componentsPath": "docs/c4/3-components/"
  },
  "skin": "default",
  "groups": [
    { "id": "inputs", "label": "Inputs" },
    { "id": "core", "label": "Core" },
    { "id": "outputs", "label": "Outputs" }
  ],
  "nodes": [
    {
      "id": "upload",
      "label": "Hero / overlay upload",
      "kind": "input",
      "groupId": "inputs",
      "shape": "rounded"
    },
    {
      "id": "looks-mood",
      "label": "Catalog looks + mood",
      "kind": "input",
      "groupId": "inputs",
      "shape": "rounded"
    },
    {
      "id": "tune",
      "label": "Intensity / Motion / Grit",
      "kind": "input",
      "groupId": "inputs",
      "shape": "rounded"
    },
    {
      "id": "spa",
      "label": "Studio SPA + Zustand",
      "kind": "process",
      "groupId": "core",
      "shape": "rect"
    },
    {
      "id": "shader",
      "label": "Single-pass GLSL compositor",
      "kind": "process",
      "groupId": "core",
      "shape": "rect"
    },
    {
      "id": "mood-api",
      "label": "Mood API (optional)",
      "kind": "process",
      "groupId": "core",
      "shape": "stadium"
    },
    {
      "id": "openai",
      "label": "OpenAI (optional)",
      "kind": "other",
      "groupId": "core",
      "shape": "ticket"
    },
    {
      "id": "preset-json",
      "label": "Preset JSON",
      "kind": "output",
      "groupId": "outputs",
      "shape": "rounded"
    },
    {
      "id": "media",
      "label": "WebM / PNG",
      "kind": "output",
      "groupId": "outputs",
      "shape": "rounded"
    },
    {
      "id": "embed",
      "label": "Your site (embed)",
      "kind": "output",
      "groupId": "outputs",
      "shape": "rect"
    }
  ],
  "edges": [
    { "id": "e-upload-spa", "from": "upload", "to": "spa", "label": "textures", "style": "solid" },
    { "id": "e-looks-spa", "from": "looks-mood", "to": "spa", "label": "look or prompt", "style": "solid" },
    { "id": "e-tune-spa", "from": "tune", "to": "spa", "label": "patch", "style": "solid" },
    { "id": "e-spa-shader", "from": "spa", "to": "shader", "label": "uniforms", "style": "solid" },
    { "id": "e-spa-mood", "from": "spa", "to": "mood-api", "label": "POST /api/mood", "style": "dashed" },
    { "id": "e-mood-openai", "from": "mood-api", "to": "openai", "label": "chat completions", "style": "dashed" },
    { "id": "e-shader-json", "from": "shader", "to": "preset-json", "label": "coefficients", "style": "solid" },
    { "id": "e-shader-media", "from": "shader", "to": "media", "label": "capture", "style": "solid" },
    { "id": "e-json-embed", "from": "preset-json", "to": "embed", "label": "reuse look", "style": "solid" }
  ],
  "tour": ["upload", "looks-mood", "tune", "shader", "preset-json"],
  "captions": [
    {
      "id": "upload",
      "title": "Optional hero",
      "body": "Upload a hero texture (and optional overlay) so the canvas has something to grade.",
      "spotlightIds": ["upload", "spa"]
    },
    {
      "id": "looks-mood",
      "title": "Pick a look",
      "body": "Choose one of fourteen catalog looks, or describe a mood—keywords always work; AI is optional.",
      "spotlightIds": ["looks-mood", "spa", "mood-api"]
    },
    {
      "id": "tune",
      "title": "Tune the feel",
      "body": "Intensity, Motion, and Grit map onto background-layer shader fields without exposing every uniform.",
      "spotlightIds": ["tune", "spa"]
    },
    {
      "id": "shader",
      "title": "One GPU pass",
      "body": "A single fragment program warps, samples, shades, and composites hero, overlay, and preview text.",
      "spotlightIds": ["spa", "shader"]
    },
    {
      "id": "preset-json",
      "title": "Export coefficients",
      "body": "Download or copy preset JSON to reuse the same look on your site; WebM and PNG are optional extras.",
      "items": ["Primary output is preset JSON", "WebM / PNG need a hero texture", "Embed guide: src/lib/preset/PORTING.md"],
      "spotlightIds": ["preset-json", "media", "embed"]
    }
  ]
}
