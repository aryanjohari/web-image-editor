%% C4 Containers — Background Studio
%% IDs: studio-spa (Container spa), mood-api (Container moodApi)
%% If your Mermaid renderer lacks C4Container, use the flowchart block at the bottom (uncomment it / paste into a viewer).

C4Container
  title Containers — Background Studio
  Person(designer, "Designer", "Uploads textures, tunes looks, exports")

  System_Boundary(studio, "Background Studio") {
    Container(spa, "Background Studio SPA", "Vite, React, R3F, GLSL, Zustand", "Routes, scene store, single-pass WebGL compositor, preset / mood / export client")
    Container(moodApi, "Mood API", "Vercel serverless", "Optional POST /api/mood → OpenAI → validated basePresetId + patch")
  }

  System_Ext(openai, "OpenAI API", "Chat Completions")
  System_Ext(embedSite, "Your production site", "Consumes preset JSON")

  Rel(designer, spa, "Uses in the browser")
  Rel(spa, embedSite, "Exports preset JSON")
  Rel(spa, designer, "Optional WebM / PNG")
  Rel(spa, moodApi, "POST /api/mood when AI enabled (gets basePresetId + patch)", "HTTPS")
  Rel(moodApi, openai, "Chat completions", "HTTPS")

