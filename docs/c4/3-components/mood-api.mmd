%% C3 Components — mood-api (optional Vercel serverless)

C4Component
  title Components — Mood API
  Container_Boundary(mood, "mood-api") {
    Component(handler, "Vercel handler", "api/mood.ts", "POST only; env gate; upstream fetch")
    Component(prompt, "System prompt builder", "src/lib/mood/buildAiMoodSystemPrompt.ts", "Catalog-aware director prompt")
    Component(parse, "Parse and validate", "src/lib/mood/parseAiMoodResponse.ts", "basePresetId + optional patch or 422")
  }

  System_Ext(openai, "OpenAI Chat Completions", "Upstream HTTPS")

  Rel(handler, prompt, "Builds system message")
  Rel(handler, openai, "chat/completions", "HTTPS")
  Rel(handler, parse, "Validates model JSON")

