%% C3 Components — studio-spa (Background Studio SPA)
%% Prefer C4Component when the viewer supports it; flowchart below is the accurate fallback topology.

C4Component
  title Components — Background Studio SPA
  Container_Boundary(spa, "studio-spa") {
    Component(shells, "Route shells", "React Router", "/ · /lab · /story")
    Component(store, "Zustand scene store", "Zustand", "Textures, layer effect maps, UI tabs — in-memory")
    Component(catalog, "Preset catalog", "TypeScript data", "14 looks (7 featured + 7 legacy)")
    Component(preset, "Preset lib", "TypeScript", "Build, validate, hydrate, apply modes, share URLs")
    Component(moodClient, "Mood client", "TypeScript", "Keywords always; optional POST /api/mood then fallback")
    Component(semantic, "Semantic sliders", "TypeScript", "Intensity / Motion / Grit → PresetPatch")
    Component(decal, "Decal pipeline", "Canvas / Three", "Processed overlay texture from upload")
    Component(canvasHost, "R3F canvas host", "R3F + drei", "Orthographic camera, one full-screen quad, preserveDrawingBuffer")
    Component(material, "SynthMaterial", "Three ShaderMaterial", "Each frame: store → uniforms; text CanvasTextures; export clock")
    Component(shader, "GLSL fragment compositor", "GLSL", "Warp → sample → shade → composite L0 / L1 / T0–T3")
    Component(exportLib, "Export", "TypeScript + MediaRecorder", "Preset JSON from store; WebM/PNG from canvas")
  }

  Rel(shells, store, "Reads / writes")
  Rel(moodClient, preset, "Applies style + optional patch")
  Rel(semantic, preset, "Applies patch")
  Rel(catalog, preset, "Supplies looks")
  Rel(decal, store, "setDecalTexture")
  Rel(preset, store, "Hydrates coefficients")
  Rel(store, material, "getState each frame")
  Rel(canvasHost, material, "Hosts mesh")
  Rel(material, shader, "Uniforms + samplers")
  Rel(store, exportLib, "buildPreset")
  Rel(canvasHost, exportLib, "Canvas capture")

