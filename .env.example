# Server only — set in Vercel project env or `vercel dev` (never use VITE_ prefix)
# Stage Phase 2 brief AI (Gemini). OPENAI_API_KEY is no longer used for mood/brief.
GEMINI_API_KEY=
# GOOGLE_API_KEY=   # accepted as an alias for GEMINI_API_KEY

# Optional model override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Stage Phase 4 Jobs API — required for /api/v1/* (except GET /api/v1/health)
# Lab /api/brief and /api/mood stay keyless (Gemini only).
STAGE_API_KEY=sk_stage_dev_change_me
# STAGE_API_KEYS=sk_stage_a,sk_stage_b  # comma-separated allowlist (merged with STAGE_API_KEY)

# Client toggle — "true" attempts POST /api/brief (lab) / /api/mood (landing) before keyword fallback
VITE_STAGE_BRIEF_AI_ENABLED=true
# VITE_MOOD_AI_ENABLED=true  # legacy alias; still works if STAGE flag unset
